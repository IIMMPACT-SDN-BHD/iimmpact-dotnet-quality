<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>iimmpact-quality</ToolCommandName>
    <PackageId>IIMMPACT.CodeQuality.Tool</PackageId>
    <Description>Checks .NET solutions against the IIMMPACT code-quality baseline. Build warnings become gate failures only when they grow past the baseline.</Description>
    <PackageTags>iimmpact;code-quality;dotnet-tool;baseline;sarif;ci;quality-gate</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- Syntax-only declaration attribution for per-declaration baseline entries. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="IIMMPACT.CodeQuality.Tool.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../IIMMPACT.CodeQuality/IIMMPACT.CodeQuality.globalconfig" LogicalName="Policy.IIMMPACT.CodeQuality.globalconfig" />
    <EmbeddedResource Include="../IIMMPACT.CodeQuality/SonarLint.xml" LogicalName="Policy.SonarLint.xml" />
    <EmbeddedResource Include="../IIMMPACT.CodeQuality/CodeMetricsConfig.txt" LogicalName="Policy.CodeMetricsConfig.txt" />
    <EmbeddedResource Include="../IIMMPACT.CodeQuality/BannedSymbols.IIMMPACT.txt" LogicalName="Policy.BannedSymbols.IIMMPACT.txt" />
  </ItemGroup>

</Project>
