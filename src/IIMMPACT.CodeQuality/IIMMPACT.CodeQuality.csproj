<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>false</SuppressDependenciesWhenPacking>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DevelopmentDependency>true</DevelopmentDependency>

    <PackageId>IIMMPACT.CodeQuality</PackageId>
    <Description>Shared IIMMPACT C# code-quality rules: analyzer configuration, banned APIs, and thresholds for SonarAnalyzer and Microsoft.CodeAnalysis rules.</Description>
    <PackageTags>iimmpact;code-quality;analyzers;roslyn;sonaranalyzer;banned-api;complexity;maintainability</PackageTags>
  </PropertyGroup>

  <!-- PrivateAssets="none" so analyzer assets from these packages flow to consumers. -->
  <ItemGroup>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" PrivateAssets="none" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="4.14.0" PrivateAssets="none" />
  </ItemGroup>

  <ItemGroup>
    <None Include="build\IIMMPACT.CodeQuality.props" Pack="true" PackagePath="build\IIMMPACT.CodeQuality.props" />
    <None Include="build\IIMMPACT.CodeQuality.targets" Pack="true" PackagePath="build\IIMMPACT.CodeQuality.targets" />
    <None Include="IIMMPACT.CodeQuality.globalconfig" Pack="true" PackagePath="build\IIMMPACT.CodeQuality.globalconfig" />
    <None Include="CodeMetricsConfig.txt" Pack="true" PackagePath="build\CodeMetricsConfig.txt" />
    <None Include="SonarLint.xml" Pack="true" PackagePath="build\SonarLint.xml" />
    <None Include="BannedSymbols.IIMMPACT.txt" Pack="true" PackagePath="build\BannedSymbols.IIMMPACT.txt" />
    <!-- Empty placeholder so the build-only package declares netstandard2.0 compatibility (NU5128). -->
    <None Include="_._" Pack="true" PackagePath="lib\netstandard2.0\_._" />
  </ItemGroup>

</Project>
